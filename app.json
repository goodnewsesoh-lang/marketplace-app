{
  "expo": {
    "name": "Marketplace",
    "slug": "marketplace",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "marketplace",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Marketplace needs access to your photos so you can add pictures to your profile, store and products."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.goodnews.marketplace"
    },
    "android": {
      "package": "com.goodnews.marketplace"
    }
  }
}
